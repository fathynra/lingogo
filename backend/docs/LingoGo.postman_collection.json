{
  "info": {
    "name": "LingoGo API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Isi variabel apiKey (dari kelompok lingogo), demoEmail/demoPassword, adminEmail/adminPassword."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://lingogo.stei.site/api"
    },
    {
      "key": "apiKey",
      "value": ""
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "adminToken",
      "value": ""
    },
    {
      "key": "demoEmail",
      "value": "demo@lingogo.stei.site"
    },
    {
      "key": "demoPassword",
      "value": ""
    },
    {
      "key": "adminEmail",
      "value": "admin@lingogo.stei.site"
    },
    {
      "key": "adminPassword",
      "value": ""
    }
  ],
  "item": [
