# Salin ke .env lalu isi. JANGAN commit .env.

# Rahasia JWT: HARUS sama untuk phrase-service & user-service. Buat: openssl rand -hex 32
JWT_SECRET=GANTI_DENGAN_HASIL_openssl_rand_-hex_32
JWT_EXPIRE_MINUTES=10080

# API key untuk kelompok lain, format nama:kunci dipisah koma. Buat tiap kunci: openssl rand -hex 16
API_KEYS=kelompokcontoh:GANTI_KUNCI_1,kelompokkedua:GANTI_KUNCI_2

# Akun admin (boleh ubah data frasa) & akun uji untuk penilai / kelompok lain
ADMIN_EMAIL=admin@lingogo.stei.site
ADMIN_PASSWORD=GANTI_PASSWORD_ADMIN
DEMO_EMAIL=demo@lingogo.stei.site
DEMO_PASSWORD=GANTI_PASSWORD_DEMO

# URL publik (kosongkan untuk path relatif /api/audio/...)
PUBLIC_BASE_URL=https://lingogo.stei.site

# Port gateway di host (uji LAN)
GATEWAY_PORT=8080

# (Opsional) folder audio di host. Default: ../tts/out/audio (WAV hasil generate.py).
# Jika nanti dikonversi ke MP3 yang lebih kecil, arahkan ke folder MP3-nya.
# AUDIO_HOST_DIR=../tts/out/audio

# Token Cloudflare Tunnel (dari dashboard; hanya perlu di STB)
TUNNEL_TOKEN=
